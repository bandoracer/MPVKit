+            p->end_time_av, now, ao->samplerate, ao->device_buffer,
+            p->renderer.readyForMoreMediaData);
+        *state = (struct mp_pcm_state){
+            .free_samples = queued.free_samples,
+            .queued_samples = queued.queued_samples,
+            .delay = queued.delay,
+            .playing = queued.queued_samples > 0 && p->renderer.status != AVQueuedSampleBufferRenderingStatusFailed,
+        };
+    });
+}
