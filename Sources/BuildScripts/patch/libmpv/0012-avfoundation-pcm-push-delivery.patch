+// AVFoundation is a non-real-time queue. PCM uses MPV's push contract so
+// decoder availability wakes the AO; renderer readiness must never drain a
+// pull device in a tight loop and manufacture an underrun on an empty decoder.
+static bool write_pcm(struct ao *ao, void **data, int samples)
+{
+    struct priv *p = ao->priv;
+    __block bool result = true;
+    dispatch_sync(p->queue, ^{
+        for (int offset = 0; offset < samples;) {
+            int count = MPMIN(ao->samplerate / 10, samples - offset);
+            void *block[] = {(char *)data[0] + offset * ao->sstride};
+            if (!enqueue_audio(ao, block, count)) {
+                result = false;
+                break;
+            }
+            offset += count;
+        }
+    });
+    return result;
+}
