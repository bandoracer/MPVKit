+#ifndef MP_AVFOUNDATION_PCM_QUEUE_H
+#define MP_AVFOUNDATION_PCM_QUEUE_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <math.h>
+struct av_pcm_queue_state {
+    int free_samples;
+    int queued_samples;
+    double delay;
+};
+// Queue occupancy belongs to the presentation clock, not to PCM block leases
+// or to readiness for more data. Whole periods keep refill work bounded.
+static inline struct av_pcm_queue_state av_pcm_queue_state(
+    int64_t end_ns, int64_t now_ns, int rate, int capacity, bool ready)
+{
+    int64_t ns = end_ns > now_ns ? end_ns - now_ns : 0;
+    int queued = (int)ceil(ns / 1e9 * rate);
+    int period = rate / 10;
+    int available = capacity > queued ? capacity - queued : 0;
+    return (struct av_pcm_queue_state){
+        .free_samples = ready && period > 0 ? available / period * period : 0,
+        .queued_samples = queued,
+        .delay = ns / 1e9,
+    };
+}
+#endif
