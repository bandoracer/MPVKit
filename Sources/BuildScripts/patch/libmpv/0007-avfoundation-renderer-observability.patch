+static const char *renderer_status_name(AVQueuedSampleBufferRenderingStatus status)
+{
+    switch (status) {
+    case AVQueuedSampleBufferRenderingStatusUnknown:
+        return "unknown";
+    case AVQueuedSampleBufferRenderingStatusRendering:
+        return "rendering";
+    case AVQueuedSampleBufferRenderingStatusFailed:
+        return "failed";
+    }
+    return "invalid";
+}
+
+static void log_renderer_state(struct ao *ao, const char *event)
+{
+    struct priv *p = ao->priv;
+    AVQueuedSampleBufferRenderingStatus status = p->renderer.status;
+    NSError *error = p->renderer.error;
+    bool sufficient = false;
+#if HAVE_MACOS_11_3_FEATURES
+    if (@available(tvOS 14.5, iOS 14.5, macOS 11.3, *))
+        sufficient = p->renderer.hasSufficientMediaDataForReliablePlaybackStart;
+#endif
+    CMTime current_time = [p->synchronizer currentTime];
+    double seconds = CMTIME_IS_NUMERIC(current_time)
+        ? CMTimeGetSeconds(current_time) : -1.0;
+    double timebase_rate = CMTimebaseGetRate(p->synchronizer.timebase);
+    const char *error_domain = error ? error.domain.UTF8String : "none";
+    long error_code = error ? (long)error.code : 0;
+
+    // Warning level is intentional: Marquee requests warning-level libmpv
+    // messages so authenticated media URLs never enter its shareable log.
+    MP_WARN(ao, "apple-renderer-state event=%s status=%s errorDomain=%s "
+            "errorCode=%ld sufficient=%s readyForMore=%s synchronizerRate=%.3f "
+            "timebaseRate=%.3f time=%.3f\n",
+            event, renderer_status_name(status), error_domain, error_code,
+            sufficient ? "true" : "false",
+            p->renderer.readyForMoreMediaData ? "true" : "false",
+            p->synchronizer.rate, timebase_rate, seconds);
+}
+
+static void record_renderer_progress(struct ao *ao, uint64_t sample_count)
+{
+    struct priv *p = ao->priv;
+    p->enqueued_sample_count += sample_count;
+
+    bool sufficient = false;
+#if HAVE_MACOS_11_3_FEATURES
+    if (@available(tvOS 14.5, iOS 14.5, macOS 11.3, *))
+        sufficient = p->renderer.hasSufficientMediaDataForReliablePlaybackStart;
+#endif
+    if (!p->sufficient_media_observed ||
+        sufficient != p->last_sufficient_media)
+    {
+        p->sufficient_media_observed = true;
+        p->last_sufficient_media = sufficient;
+        log_renderer_state(ao, "sufficient-media-change");
+    }
+
+    int64_t now = mp_time_ns();
+    if (!p->last_progress_log_ns ||
+        now - p->last_progress_log_ns >= INT64_C(5000000000))
+    {
+        p->last_progress_log_ns = now;
+        MP_WARN(ao, "apple-renderer-progress enqueuedSamples=%llu "
+                "enqueuedEnd=%.3f\n",
+                (unsigned long long)p->enqueued_sample_count,
+                p->end_time_av / 1e9);
+        log_renderer_state(ao, "progress");
+    }
+}
