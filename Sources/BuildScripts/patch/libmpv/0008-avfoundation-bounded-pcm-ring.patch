+static void free_pcm_ring(struct priv *p)
+{
+    if (!p->pcm_ring_block_size)
+        return;
+    for (int n = 0; n < PCM_RING_SLOT_COUNT; n++) {
+        // The renderer is flushed and released before this function. Its
+        // CMBlockBuffer release callbacks must therefore have returned every
+        // slot to the pool before backing storage can be destroyed.
+        mp_assert(!atomic_load_explicit(&p->pcm_ring[n].leased, memory_order_acquire));
+        if (p->pcm_ring[n].data)
+            CFAllocatorDeallocate(NULL, p->pcm_ring[n].data);
+        p->pcm_ring[n].data = NULL;
+        p->pcm_ring[n].lease_count = 0;
+    }
+    p->pcm_ring_block_size = 0;
+    p->pcm_ring_next = 0;
+}
+
+static bool allocate_pcm_ring(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    p->pcm_ring_block_size = (size_t)(ao->samplerate / 10) * ao->sstride;
+    if (!p->pcm_ring_block_size)
+        return false;
+    for (int n = 0; n < PCM_RING_SLOT_COUNT; n++)
+        atomic_init(&p->pcm_ring[n].leased, false);
+    for (int n = 0; n < PCM_RING_SLOT_COUNT; n++) {
+        p->pcm_ring[n].data = CFAllocatorAllocate(NULL, p->pcm_ring_block_size, 0);
+        if (!p->pcm_ring[n].data) {
+            free_pcm_ring(p);
+            return false;
+        }
+    }
+    MP_INFO(ao, "allocated bounded Apple PCM ring: slots=%d blockBytes=%llu "
+            "totalBytes=%llu\n", PCM_RING_SLOT_COUNT,
+            (unsigned long long)p->pcm_ring_block_size,
+            (unsigned long long)(p->pcm_ring_block_size * PCM_RING_SLOT_COUNT));
+    return true;
+}
+
+static void release_pcm_ring_block(void *refcon, void *memory, size_t size)
+{
+    (void)memory;
+    (void)size;
+    struct pcm_ring_slot *slot = refcon;
+    atomic_store_explicit(&slot->leased, false, memory_order_release);
+}
+
+static int acquire_pcm_ring_slot(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    for (int n = 0; n < PCM_RING_SLOT_COUNT; n++) {
+        unsigned int slot_index = p->pcm_ring_next++ % PCM_RING_SLOT_COUNT;
+        struct pcm_ring_slot *slot = &p->pcm_ring[slot_index];
+        bool expected = false;
+        if (atomic_compare_exchange_strong_explicit(
+                &slot->leased, &expected, true,
+                memory_order_acq_rel, memory_order_relaxed))
+        {
+            if (slot->lease_count)
+                p->pcm_ring_reuse_count++;
+            slot->lease_count++;
+            return slot_index;
+        }
+    }
+    MP_FATAL(ao, "bounded Apple PCM ring exhausted while CoreMedia still owns every slot\n");
+    return -1;
+}
