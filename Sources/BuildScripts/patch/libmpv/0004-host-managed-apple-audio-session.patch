     .list_devs      = ca_get_device_list,
 #endif
     .priv_size      = sizeof(struct priv),
+    .options = (const struct m_option[]){
+        {"host-managed-audio-session", OPT_BOOL(host_managed_audio_session)},
+        {0}
+    },
+    .options_prefix = "avfoundation",
 };
