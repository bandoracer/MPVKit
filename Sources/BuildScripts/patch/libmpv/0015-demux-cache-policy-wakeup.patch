+// Called by the player core after committing option changes. Wake under the
+// demux lock so a paused/full reader cannot miss the signal before sleeping.
+// Unlike starting prefetch, this does not change the reader's lifecycle.
+void demux_notify_options_changed(struct demuxer *demuxer)
+{
+    struct demux_internal *in = demuxer->in;
+    mp_mutex_lock(&in->lock);
+    mp_cond_signal(&in->wakeup);
+    mp_mutex_unlock(&in->lock);
+}
+
 void demux_start_prefetch(struct demuxer *demuxer)
 {
     struct demux_internal *in = demuxer->in;
@@ -2520,10 +2532,17 @@
 static bool thread_work(struct demux_internal *in)
 {
     struct demux_opts *opts = in->d_user->opts;
+    double old_min_secs = in->min_secs;
     size_t old_max_bytes = opts->max_bytes;
     size_t old_max_bytes_bw = opts->max_bytes_bw;
     if (m_config_cache_update(in->d_user->opts_cache)) {
         update_opts(in->d_user);
+        // A full cache clears reading. Growing its allowance must re-arm
+        // prefetch as well as wake the thread; no decoder consumes packets
+        // while paused to otherwise re-arm it. read_packet still enforces
+        // cancellation, blocked readers, byte limits, and the new time limit.
+        if (!in->eof && (in->min_secs > old_min_secs || opts->max_bytes > old_max_bytes))
+            in->reading = true;
         if (opts->max_bytes + opts->max_bytes_bw < old_max_bytes + old_max_bytes_bw)
             demux_packet_pool_clear(in->packet_pool);
     }
