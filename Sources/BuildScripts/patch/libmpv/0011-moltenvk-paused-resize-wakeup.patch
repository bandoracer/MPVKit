--- a/video/out/vulkan/context_moltenvk.m
+++ b/video/out/vulkan/context_moltenvk.m
@@ -23,9 +23,64 @@
 #include "context.h"
 #include "utils.h"

+// Author-Tag: ai-2026-09-05-paused-geometry
+// A paused VO may sleep until explicitly woken. Geometry changes belong to
+// the layer, but swapchain/viewport commit remains on the video-output thread.
+// The observer's lock excludes a wakeup racing context destruction.
+@interface MPVMetalResizeObserver : NSObject {
+    NSLock *_lifetimeLock;
+    CAMetalLayer *_observedLayer;
+    struct vo *_owner;
+}
+- (instancetype)initWithLayer:(CAMetalLayer *)layer owner:(struct vo *)owner;
+- (void)invalidate;
+@end
+
+@implementation MPVMetalResizeObserver
+- (instancetype)initWithLayer:(CAMetalLayer *)layer owner:(struct vo *)owner
+{
+    if ((self = [super init])) {
+        _lifetimeLock = [[NSLock alloc] init];
+        _observedLayer = [layer retain];
+        _owner = owner;
+        [_observedLayer addObserver:self forKeyPath:@"drawableSize" options:0 context:NULL];
+    }
+    return self;
+}
+
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object
+                       change:(NSDictionary *)change context:(void *)context
+{
+    [_lifetimeLock lock];
+    if (_owner)
+        vo_wakeup(_owner);
+    [_lifetimeLock unlock];
+}
+
+- (void)invalidate
+{
+    [_lifetimeLock lock];
+    _owner = NULL;
+    [_lifetimeLock unlock];
+    if (_observedLayer) {
+        [_observedLayer removeObserver:self forKeyPath:@"drawableSize"];
+        [_observedLayer release];
+        _observedLayer = nil;
+    }
+}
+
+- (void)dealloc
+{
+    [self invalidate];
+    [_lifetimeLock release];
+    [super dealloc];
+}
+@end
+
 struct priv {
     struct mpvk_ctx vk;
     CAMetalLayer *layer;
+    MPVMetalResizeObserver *resize_observer;
     int width;
     int height;
 };
