     void *logctx;
diff --git a/libavcodec/pthread_frame.c b/libavcodec/pthread_frame.c
index c285308..f17d49e 100644
--- a/libavcodec/pthread_frame.c
+++ b/libavcodec/pthread_frame.c
@@ -1002,5 +1002,21 @@ av_cold void ff_thread_flush(AVCodecContext *avctx)
         p->result = 0;

+        // Author-Tag: ai-2026-09-08-seek-flash-reproduction
+        // Serialized hwaccels live in the parent stash while workers are
+        // parked. Let the first codec context flush that shared state once,
+        // then return ownership to the stash for the next submitted frame.
+        const int restore_hwaccel = i == 0 && fctx->stash_hwaccel;
+        if (restore_hwaccel) {
+            av_assert0(!p->avctx->hwaccel && !p->hwaccel_threadsafe);
+            FFSWAP(const AVHWAccel*, p->avctx->hwaccel, fctx->stash_hwaccel);
+            FFSWAP(void*, p->avctx->hwaccel_context, fctx->stash_hwaccel_context);
+            FFSWAP(void*, p->avctx->internal->hwaccel_priv_data, fctx->stash_hwaccel_priv);
+        }
         avcodec_flush_buffers(p->avctx);
+        if (restore_hwaccel) {
+            FFSWAP(const AVHWAccel*, p->avctx->hwaccel, fctx->stash_hwaccel);
+            FFSWAP(void*, p->avctx->hwaccel_context, fctx->stash_hwaccel_context);
+            FFSWAP(void*, p->avctx->internal->hwaccel_priv_data, fctx->stash_hwaccel_priv);
+        }
     }
 }
