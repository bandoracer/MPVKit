diff --git a/libavcodec/videotoolbox.c b/libavcodec/videotoolbox.c
index 2cd22cb..ea8f16a 100644
--- a/libavcodec/videotoolbox.c
+++ b/libavcodec/videotoolbox.c
@@ -756,4 +756,14 @@ static OSStatus videotoolbox_session_decode_frame(AVCodecContext *avctx)
         return -1;

+    // Author-Tag: ai-2026-09-08-seek-flash-reproduction
+    // Recovery-point samples are not necessarily IDRs. Tell VideoToolbox
+    // explicitly when they begin a new decode sequence.
+    if (vtctx->reset_decoder && !((H264Context *)avctx->priv_data)->picture_idr) {
+        CMSetAttachment(sample_buf,
+                        kCMSampleBufferAttachmentKey_ResetDecoderBeforeDecoding,
+                        kCFBooleanTrue, kCMAttachmentMode_ShouldNotPropagate);
+        av_log(avctx, AV_LOG_VERBOSE, "VideoToolbox H.264 decode discontinuity\n");
+    }
+
     status = VTDecompressionSessionDecodeFrame(videotoolbox->session,
                                                sample_buf,
@@ -761,6 +771,8 @@ static OSStatus videotoolbox_session_decode_frame(AVCodecContext *avctx)
                                                NULL,    // sourceFrameRefCon
                                                0);      // infoFlagsOut
-    if (status == noErr)
+    if (status == noErr) {
+        vtctx->reset_decoder = false;
         status = VTDecompressionSessionWaitForAsynchronousFrames(videotoolbox->session);
+    }

     CFRelease(sample_buf);
@@ -903,4 +915,5 @@ static int videotoolbox_start(AVCodecContext *avctx)
 {
     AVVideotoolboxContext *videotoolbox = videotoolbox_get_context(avctx);
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
     OSStatus status;
     VTDecompressionOutputCallbackRecord decoder_cb;
@@ -1026,4 +1039,5 @@ static int videotoolbox_start(AVCodecContext *avctx)
         return AVERROR_INVALIDDATA;
     case 0:
+        vtctx->reset_decoder = avctx->codec_id == AV_CODEC_ID_H264;
         return 0;
     default:
@@ -1088,4 +1102,21 @@ static int videotoolbox_h264_end_frame(AVCodecContext *avctx)
 }

+// Author-Tag: ai-2026-09-08-seek-flash-reproduction
+static void videotoolbox_h264_flush(AVCodecContext *avctx)
+{
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+
+    // H.264 flushes its software DPB at a discontinuity. VideoToolbox also
+    // retains reference pictures, which must not survive that boundary:
+    // open-GOP recovery pictures can otherwise reference the previous seek.
+    // The next submitted sample carries the CoreMedia discontinuity marker.
+    vtctx->reset_decoder = true;
+    vtctx->bitstream_size = 0;
+    if (vtctx->frame) {
+        CVPixelBufferRelease(vtctx->frame);
+        vtctx->frame = NULL;
+    }
+}
+
 static int videotoolbox_hevc_start_frame(AVCodecContext *avctx,
                                          const AVBufferRef *buffer_ref,
@@ -1385,4 +1416,5 @@ const FFHWAccel ff_h264_videotoolbox_hwaccel = {
     .decode_params  = videotoolbox_h264_decode_params,
     .end_frame      = videotoolbox_h264_end_frame,
+    .flush          = videotoolbox_h264_flush,
     .frame_params   = ff_videotoolbox_frame_params,
     .init           = ff_videotoolbox_common_init,
